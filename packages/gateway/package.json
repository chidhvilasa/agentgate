{
  "name": "@agentgate/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGate gateway: MCP stdio proxy, policy evaluation pipeline, tamper-evident audit storage, loopback Control API, and CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentgate": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentgate/policy": "workspace:*",
    "@agentgate/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "better-sqlite3": "^11.2.1",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "js-yaml": "^4.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
