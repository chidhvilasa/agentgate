{
  "name": "agentgate-monorepo",
  "private": true,
  "description": "AgentGate — the open-source firewall for AI agents. Monorepo root (workspace scripts only; not published).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chidhvilasa/agentgate.git"
  },
  "homepage": "https://github.com/chidhvilasa/agentgate#readme",
  "bugs": "https://github.com/chidhvilasa/agentgate/issues",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "dev:control": "pnpm --filter @agentgate/control-center dev",
    "dev:gateway": "pnpm --filter @agentgate/gateway dev",
    "dev": "pnpm run dev:control & pnpm run dev:gateway"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.20.1",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "micromatch": "^4.0.8"
  }
}
